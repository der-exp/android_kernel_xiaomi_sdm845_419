# nf_tables for the steer traffic engine.
#
# steer programs its rules through nf_tables (netlink), not iptables. On
# this 4.19 kernel it runs in its compatibility mode: ip/ip6 tables for nat,
# hash sets with timeouts, interval (rbtree) sets without timeouts, meta
# mark/skuid, ct mark/state, dynset, lookup/vmap, dnat/redirect/masquerade,
# queue, counter, limit, numgen, log and reject. Everything is built in:
# this device ships no loadable netfilter modules.
#
# Merged after sdm845-perf_defconfig and sdm845-common.config. Options whose
# dependencies are missing are silently dropped by olddefconfig, so the
# dependencies are spelled out here as well.

# Core and families
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_NETDEV=y

# Expressions. lookup, dynset, payload, cmp, bitwise, and on 4.19 also meta,
# exthdr and rt are part of the core; the rest are separate options.
CONFIG_NFT_CT=y
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_QUOTA=y
CONFIG_NFT_HASH=y
CONFIG_NFT_COMPAT=y

# Set backends: hash (supports element timeouts) and rbtree (intervals).
# On 4.19 they are one option together with the bitmap backend.
CONFIG_NF_TABLES_SET=y

# Queue to userspace (NFQUEUE)
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NFT_QUEUE=y

# NAT: dnat/snat, redirect and masquerade for IPv4 and IPv6.
# IPv6 NAT is off in sdm845-perf_defconfig; the nft ip6 nat chain needs it.
CONFIG_NF_NAT=y
CONFIG_NF_NAT_IPV4=y
CONFIG_NF_NAT_IPV6=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_NF_NAT_MASQUERADE_IPV4=y
CONFIG_NF_NAT_MASQUERADE_IPV6=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_CHAIN_NAT_IPV4=y
CONFIG_NFT_CHAIN_NAT_IPV6=y
CONFIG_NFT_MASQ_IPV4=y
CONFIG_NFT_MASQ_IPV6=y
CONFIG_NFT_REDIR_IPV4=y
CONFIG_NFT_REDIR_IPV6=y

# Route chains (re-route after changing the packet mark)
CONFIG_NFT_CHAIN_ROUTE_IPV4=y
CONFIG_NFT_CHAIN_ROUTE_IPV6=y

# Reject
CONFIG_NF_REJECT_IPV4=y
CONFIG_NF_REJECT_IPV6=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_REJECT_IPV4=y
CONFIG_NFT_REJECT_IPV6=y

# Packet duplication
CONFIG_NF_DUP_IPV4=y
CONFIG_NF_DUP_IPV6=y
CONFIG_NF_DUP_NETDEV=y
CONFIG_NFT_DUP_IPV4=y
CONFIG_NFT_DUP_IPV6=y
CONFIG_NFT_DUP_NETDEV=y
CONFIG_NFT_FWD_NETDEV=y

# Log backends used by the nft "log" expression
CONFIG_NF_LOG_COMMON=y
CONFIG_NF_LOG_IPV4=y
CONFIG_NF_LOG_IPV6=y

# iptables -t raw ... -j CT/NOTRACK, used alongside nf_tables
CONFIG_NETFILTER_XT_TARGET_CT=y
CONFIG_NETFILTER_XT_TARGET_NOTRACK=y

# AmneziaWG: WireGuard with traffic obfuscation, built in next to WIREGUARD
# (own genetlink family and link kind, configured with awg from amneziawg-tools)
CONFIG_AMNEZIAWG=y
